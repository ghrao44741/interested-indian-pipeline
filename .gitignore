# Generated media — large, binary, fully regenerable from manifest.json +
# source_audio + the pipeline scripts in shorts_pipeline2/. Not worth
# tracking in git; back these up separately (e.g. Drive) if needed.
*/audio/*
!*/audio/.gitkeep

*/source_audio/*
!*/source_audio/.gitkeep

*/images/*
!*/images/.gitkeep

*/videos/*
!*/videos/.gitkeep

*/output/*
!*/output/.gitkeep

# Secrets / credentials — never commit these
.env
Youtube_Interested_Indian_Upload.json
*_Upload.json
google_credentials*.json
token.json

# BGM / audio assets (large media — store separately)
bgm.mp3
ep01/bgm.mp3
ep01/bgm_orig.mp3
ep01_v1/bgm_orig.mp3
common/cta/*.mp3
common/bgm/

# Voice preview audio (ElevenLabs test clips — regenerable)
voice_previews/
# Stray preview clips written to the repo root by generate_source_audio.py
# --preview (the in-project ones are already covered by */source_audio/*)
preview_*.mp3

# Reference material and reading saved into the working folder — third-party
# content, large, and nothing the pipeline reads. Ignored specifically because
# CLAUDE.md's own quick-start says "git add -A", which would otherwise sweep
# multi-MB PDFs into the history.
*.pdf

# Machine-local tooling config (MCP client endpoints) — environment setup for
# this workstation, not part of the pipeline.
config/mcporter.json

# Voice-config sidecars written alongside every generated audio file — describe
# a regenerable binary that's itself already gitignored (e.g. common/cta/*.mp3,
# */source_audio/*); tracking the sidecar without the audio it describes is
# a confusing orphaned-metadata state, so treat both the same way.
*.voice.json

# CTA / channel images (binary, store separately)
common/cta/*.png

# Thumbnail and other generated episode images (regenerable)
ep01/thumbnail.png
ep01_v1/*.png

# Large GeoJSON data files (one-time download, not code)
*.geojson

# Manifest backups (noise — keep only current manifest.json)
*/manifest_backup_*.json

# Root-level generated outputs (large binary, fully regenerable)
ep01_final.mp4
ep01_captioned.mp4
ep01_captions.srt
test_*.png
test_aibmm_scene.png
test_map_*.png
test_photo.png
mascot_reference.png

# OS / editor cruft
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Checkpoint 3 approval records are per-machine, per-run decisions bound to
# exact file hashes. Committing one would let a stale approval travel to a
# checkout where the manifest or plan differs.
*/checkpoint_3_approval.json

# Runtime route-failure records are per-run execution state bound to a
# failure revision. Committing one would carry a stale blocking state into a
# checkout whose plan and approval are different.
*/route_failures.json
